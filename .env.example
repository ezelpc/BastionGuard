# ============================================================
# BastionGuard Configuration
# Copy to .env and update with your values
# ============================================================

# API & Server
API_PORT=3000
NODE_ENV=development

# ============================================================
# DATA PROVIDERS CONFIGURATION
# ============================================================

# --- Metrics Provider ---
# Options: prometheus | datadog | cloudwatch | newrelic
METRICS_PROVIDER=prometheus

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Datadog (si METRICS_PROVIDER=datadog)
# DATADOG_API_KEY=your-api-key
# DATADOG_APP_KEY=your-app-key
# DATADOG_SITE=datadoghq.com         # or datadoghq.eu

# AWS CloudWatch (si METRICS_PROVIDER=cloudwatch)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_CLOUDWATCH_NAMESPACE=AWS/ECS   # Namespace para filtro de métricas

# New Relic (si METRICS_PROVIDER=newrelic)
# NEWRELIC_API_KEY=NRAK-your-key
# NEWRELIC_ACCOUNT_ID=1234567
# NEWRELIC_REGION=US                 # or EU

# --- Logs Provider ---
# Options: elasticsearch | cloudwatch | loki | newrelic
LOG_PROVIDER=elasticsearch

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
# ELASTICSEARCH_API_KEY=id:api_key
# ELASTICSEARCH_INDEX=logs-*

# Loki (si LOG_PROVIDER=loki)
# LOKI_URL=http://localhost:3100
# LOKI_ORG_ID=tenant1              # para multi-tenant Loki
# LOKI_USERNAME=                   # si tiene auth
# LOKI_PASSWORD=

# CloudWatch Logs (si LOG_PROVIDER=cloudwatch — usa mismas vars AWS de arriba)
# AWS_CLOUDWATCH_LOG_GROUP_PREFIX=/ecs  # prefijo de log groups

# --- State Provider (Orchestrator) ---
# Options: kubernetes | ecs | docker-swarm
STATE_PROVIDER=kubernetes

# Kubernetes
K8S_NAMESPACE=default
# KUBECONFIG=~/.kube/config        # opcional para dev local

# AWS ECS (si STATE_PROVIDER=ecs)
# AWS_ECS_CLUSTER=my-cluster       # nombre del cluster ECS
# (usa las mismas credenciales AWS de arriba)

# Docker Swarm (si STATE_PROVIDER=docker-swarm)
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_TLS_VERIFY=0
# DOCKER_CERT_PATH=                # solo si TLS habilitado

# ============================================================
# AI PROVIDER
# ============================================================
# Options: claude | openai | gemini | llama
AI_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (si AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=                 # para proxies o Azure OpenAI

# Google Gemini (si AI_PROVIDER=gemini)
# GOOGLE_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-1.5-pro

# Local Ollama (si AI_PROVIDER=llama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Fallback AI providers (lista separada por coma, orden de prioridad)
# AI_FALLBACK_PROVIDERS=claude,openai,gemini

# Mock AI (para tests sin API calls)
AI_MOCK=false

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://bastionguard:dev-password@localhost:5432/bastionguard_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bastionguard_dev
DB_USER=bastionguard
DB_PASSWORD=dev-password

# ============================================================
# CACHE (Redis)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# ESCALATION CHANNELS
# ============================================================

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-token

# --- Microsoft Teams ---
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/URL

# --- Jira ---
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=ops@yourcompany.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=OPS

# --- ServiceNow ---
# SNOW_INSTANCE=yourcompany.service-now.com
# SNOW_USER=bastionguard_svc
# SNOW_PASSWORD=your-snow-password
# SNOW_ASSIGNMENT_GROUP=IT Operations

# --- Discord ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# --- Generic Webhook ---
# WEBHOOK_URL=https://your-endpoint.com/alerts
# WEBHOOK_SECRET=your-secret                # para HMAC signing
# WEBHOOK_AUTH_TYPE=bearer                  # bearer | basic | apikey | none
# WEBHOOK_AUTH_VALUE=your-token
# WEBHOOK_API_KEY_HEADER=X-API-Key          # si authType=apikey

# --- PagerDuty ---
PAGERDUTY_INTEGRATION_KEY=your-integration-key
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# --- Twilio (SMS/Voice) ---
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Enable feedback loop
ENABLE_FEEDBACK_LOOP=true

# Mock AI responses (for testing without API calls)
AI_MOCK=false

# ============================================================
# Tenant Configuration
# ============================================================

TENANTS_CONFIG=src/config/tenants.yml

# ============================================================
# Monitoring
# ============================================================

DEBUG=bastionguard:*
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090
# ============================================================
# Twilio (SMS Escalation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-token

# PagerDuty
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@bastionguard.local

# ============================================================
# Configuration Files
# ============================================================
TENANTS_CONFIG=src/config/tenants.yml

# ============================================================
# Monitoring & Logging
# ============================================================
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=data/audit-log.jsonl
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================
# Feature Flags
# ============================================================
ENABLE_COST_ANALYSIS=false
ENABLE_PREDICTIVE_AI=false
ENABLE_AUTO_LEARNING=false
ENABLE_DEMO_ENDPOINT=true

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_ALERTS_PER_MINUTE=100
RATE_LIMIT_ALERTS_PER_HOUR=2000
RATE_LIMIT_ACTIONS_PER_MINUTE=10

# ============================================================
# Third-party Integrations
# ============================================================
# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Grafana
GRAFANA_URL=http://grafana:3000
GRAFANA_API_TOKEN=

# AWS CloudWatch
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Kubernetes
KUBECONFIG=/home/node/.kube/config

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
